
# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmacore_db
DB_USER=root
DB_PASSWORD=

# ==========================================
# AUTHENTICATION
# ==========================================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ==========================================
# CORS AND APPLICATION URLS
# ==========================================
CORS_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Keep schema synchronization disabled in production
RUN_SCHEMA_SYNC=false

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
EMAIL_PROVIDER=resend
EMAIL_FROM=PharmaCore <your-verified-email-domain>
RESEND_API_KEY=

# Optional Mailtrap SMTP configuration
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_FROM=

# ==========================================
# CLOUDINARY IMAGE STORAGE
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# SUPER ADMIN BOOTSTRAP
# Only needed when deliberately running the bootstrap script
# ==========================================
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FIRST_NAME=System
SUPERADMIN_LAST_NAME=Admin

# ==========================================
# OPTIONAL PRODUCTION SEED SCRIPT
# Do not enable unless deliberately seeding demo data
# ==========================================
PHARMACORE_SEED_TARGET=